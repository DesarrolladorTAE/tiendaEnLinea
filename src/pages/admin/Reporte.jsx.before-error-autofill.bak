import React, { useEffect, useState } from "react";

import {
  Alert,
  Box,
  Button,
  Card,
  CardActionArea,
  CardContent,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Grid,
  MenuItem,
  TextField,
  Typography,
  useTheme,
} from "@mui/material";

import { alpha } from "@mui/material/styles";
import { useNavigate, useSearchParams } from "react-router-dom";

import AssessmentIcon from "@mui/icons-material/Assessment";
import ReceiptLongIcon from "@mui/icons-material/ReceiptLong";
import HourglassEmptyIcon from "@mui/icons-material/HourglassEmpty";
import SupportAgentIcon from "@mui/icons-material/SupportAgent";

import axiosClient from "../../config/axiosClient";

function UniformReportCard({
  title,
  description,
  icon,
  onClick,
  disabled = false,
}) {
  const theme = useTheme();
  const isDark = theme.palette.mode === "dark";
  const stroke = alpha(theme.palette.divider, 0.7);
  const base = isDark ? alpha("#0b1020", 0.6) : alpha("#ffffff", 0.8);

  return (
    <Card
      elevation={0}
      sx={{
        height: "100%",
        borderRadius: 18,
        border: `1px solid ${stroke}`,
        background: base,
        display: "flex",
        flexDirection: "column",
        transition:
          "transform .2s ease, box-shadow .2s ease, border-color .2s ease",
        pointerEvents: disabled ? "none" : "auto",
        opacity: disabled ? 0.6 : 1,
        "&:hover": {
          transform: "translateY(-4px)",
          boxShadow: isDark
            ? `0 10px 30px ${alpha("#000", 0.4)}`
            : `0 10px 30px ${alpha("#000", 0.12)}`,
          borderColor: alpha(theme.palette.primary.main, 0.45),
        },
      }}
    >
      <CardActionArea
        onClick={onClick}
        sx={{
          height: "100%",
          display: "flex",
          alignItems: "stretch",
          p: 0,
          "&:focus-visible": {
            outline: `2px solid ${alpha(theme.palette.primary.main, 0.7)}`,
            outlineOffset: 4,
            borderRadius: 16,
          },
        }}
      >
        <CardContent
          sx={{
            display: "flex",
            flexDirection: "column",
            gap: 1.5,
            p: 3,
            width: "100%",
          }}
        >
          {/* Header compacto */}
          <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
            <Box
              sx={{
                width: 56,
                height: 56,
                borderRadius: "50%",
                display: "grid",
                placeItems: "center",
                border: `1px solid ${alpha(theme.palette.primary.main, 0.35)}`,
                background: `linear-gradient(140deg, ${alpha(
                  theme.palette.primary.main,
                  0.12,
                )}, ${alpha(theme.palette.primary.main, 0.04)})`,
                boxShadow: `inset 0 2px 10px ${alpha("#000", 0.08)}`,
              }}
            >
              {icon}
            </Box>

            <Box sx={{ flex: 1, minWidth: 0 }}>
              <Typography
                variant="h6"
                sx={{
                  mb: 0.25,
                  whiteSpace: "nowrap",
                  overflow: "hidden",
                  textOverflow: "ellipsis",
                  letterSpacing: 0.2,
                }}
              >
                {title}
              </Typography>
              <Typography variant="body2" color="text.secondary" noWrap>
                {description}
              </Typography>
            </Box>
          </Box>

          <Divider sx={{ my: 1.5 }} />

          {/* Footer sutil */}
          <Box
            sx={{
              mt: "auto",
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
            }}
          >
            <Typography variant="caption" color="text.secondary">
              Abrir reporte
            </Typography>
            <Box
              sx={{
                px: 1.25,
                py: 0.5,
                borderRadius: 999,
                fontSize: 12,
                border: `1px solid ${alpha(theme.palette.primary.main, 0.35)}`,
                color: theme.palette.primary.main,
                backgroundColor: alpha(theme.palette.primary.main, 0.06),
              }}
            >
              Ver detalles
            </Box>
          </Box>
        </CardContent>
      </CardActionArea>
    </Card>
  );
}

export default function Reportes() {
  const navigate = useNavigate();

  const [searchParams, setSearchParams] = useSearchParams();

  const abrirSoporteDesdeUrl = searchParams.get("abrir_soporte") === "1";
  const [openSupport, setOpenSupport] = useState(false);
  const [sendingSupport, setSendingSupport] = useState(false);
  const [supportError, setSupportError] = useState("");
  const [supportSuccess, setSupportSuccess] = useState("");

  const [supportForm, setSupportForm] = useState({
    name: "",
    email: "",
    phone: "",
    section_code: "reportes",
    priority_id: 1,
    subject: "",
    description: "",
  });

  useEffect(() => {
    if (!abrirSoporteDesdeUrl) {
      return;
    }

    setSupportError("");
    setSupportSuccess("");
    setOpenSupport(true);
  }, [abrirSoporteDesdeUrl]);

  const handleOpenSupport = () => {
    setSupportError("");
    setSupportSuccess("");
    setOpenSupport(true);
  };

  const handleCloseSupport = () => {
    if (sendingSupport) return;

    setOpenSupport(false);
    setSupportError("");
    setSupportSuccess("");

    if (abrirSoporteDesdeUrl) {
      const nextParams = new URLSearchParams(searchParams);

      nextParams.delete("abrir_soporte");

      setSearchParams(nextParams, {
        replace: true,
      });
    }
  };

  const handleSupportChange = (event) => {
    const { name, value } = event.target;

    setSupportForm((current) => ({
      ...current,
      [name]: name === "priority_id" ? Number(value) : value,
    }));
  };

  const handleSupportSubmit = async (event) => {
    event.preventDefault();

    setSendingSupport(true);
    setSupportError("");
    setSupportSuccess("");

    try {
      const response = await axiosClient.post("the-business-ticket/tickets", {
        customer: {
          name: supportForm.name.trim(),
          email: supportForm.email.trim(),
          phone: supportForm.phone.trim() || null,
        },
        ticket: {
          section_code: supportForm.section_code,
          priority_id: supportForm.priority_id,
          subject: supportForm.subject.trim(),
          description: supportForm.description.trim(),
          external_reference: `mitienda-${Date.now()}`,
        },
      });

      setSupportSuccess(
        response.data?.message || "El ticket fue creado correctamente.",
      );

      setSupportForm((current) => ({
        ...current,
        subject: "",
        description: "",
      }));
    } catch (error) {
      setSupportError(
        error.response?.data?.message || "No fue posible crear el ticket.",
      );
    } finally {
      setSendingSupport(false);
    }
  };

  const items = [
    {
      title: "Reporte de Utilidades por Sucursal",
      description: "Visualiza las utilidades por punto de venta.",
      icon: <AssessmentIcon sx={{ fontSize: 30 }} />,
      route: "/admin/reportes/ventas",
    },
    {
      title: "Reporte de Ventas",
      description: "Consulta ventas por fecha, sucursal y forma de pago.",
      icon: <ReceiptLongIcon sx={{ fontSize: 30 }} />,
      route: "/admin/reportes/tipo-venta",
    },
    {
      title: "Inventario",
      description: "Consulta tu inventario actualizado 24/7.",
      icon: <ReceiptLongIcon sx={{ fontSize: 30 }} />,
      route: "/admin/reportes/inventario",
    },

    {
      title: "Reportar un problema",
      description: "Envía una solicitud al equipo de soporte.",
      icon: <SupportAgentIcon sx={{ fontSize: 30 }} />,
      onClick: handleOpenSupport,
    },

    {
      title: "Más reportes en camino",
      description: "Pronto añadiremos más reportes útiles.",
      icon: <HourglassEmptyIcon sx={{ fontSize: 30 }} />,
      route: null,
      disabled: true,
    },
  ];

  return (
    <Box
      sx={{
        p: { xs: 3, md: 4 },
        minHeight: "100%",
        background: (theme) =>
          theme.palette.mode === "dark"
            ? `linear-gradient(180deg, ${alpha("#0b1020", 1)} 0%, ${alpha("#0b1020", 0.9)} 100%)`
            : `linear-gradient(180deg, ${alpha("#f8fafc", 1)} 0%, ${alpha("#f1f5f9", 0.9)} 100%)`,
      }}
    >
      <Typography
        variant="h4"
        gutterBottom
        sx={{
          fontWeight: 700,
          letterSpacing: 0.3,
          mb: 3,
        }}
      >
        📓 Reportes
      </Typography>

      {/* Grid uniforme: todas las tarjetas misma altura */}
      <Grid container spacing={3}>
        {items.map((it, idx) => (
          <Grid item xs={12} sm={6} md={4} lg={3} key={`${it.title}-${idx}`}>
            <Box sx={{ height: "100%" }}>
              <UniformReportCard
                title={it.title}
                description={it.description}
                icon={it.icon}
                disabled={!!it.disabled}
                onClick={() => {
                  if (it.onClick) {
                    it.onClick();
                    return;
                  }

                  if (it.route) {
                    navigate(it.route);
                  }
                }}
              />
            </Box>
          </Grid>
        ))}
      </Grid>
      <Dialog
        open={openSupport}
        onClose={handleCloseSupport}
        fullWidth
        maxWidth="sm"
      >
        <Box component="form" onSubmit={handleSupportSubmit}>
          <DialogTitle>Reportar un problema</DialogTitle>

          <DialogContent>
            <Box
              sx={{
                display: "flex",
                flexDirection: "column",
                gap: 2,
                pt: 1,
              }}
            >
              {supportError && <Alert severity="error">{supportError}</Alert>}

              {supportSuccess && (
                <Alert severity="success">{supportSuccess}</Alert>
              )}

              <TextField
                label="Nombre"
                name="name"
                value={supportForm.name}
                onChange={handleSupportChange}
                required
                fullWidth
                disabled={sendingSupport}
              />

              <TextField
                label="Correo electrónico"
                name="email"
                type="email"
                value={supportForm.email}
                onChange={handleSupportChange}
                required
                fullWidth
                disabled={sendingSupport}
              />

              <TextField
                label="Teléfono"
                name="phone"
                value={supportForm.phone}
                onChange={handleSupportChange}
                fullWidth
                disabled={sendingSupport}
              />

              <TextField
                select
                label="Sección"
                name="section_code"
                value={supportForm.section_code}
                onChange={handleSupportChange}
                required
                fullWidth
                disabled={sendingSupport}
              >
                <MenuItem value="reportes">Reportes</MenuItem>
                <MenuItem value="ventas">Ventas</MenuItem>
                <MenuItem value="pagos">Pagos</MenuItem>
                <MenuItem value="inventario">Inventario</MenuItem>
                <MenuItem value="productos">Productos</MenuItem>
                <MenuItem value="pedidos">Pedidos</MenuItem>
                <MenuItem value="clientes">Clientes</MenuItem>
                <MenuItem value="facturacion">Facturación</MenuItem>
                <MenuItem value="punto-de-venta">Punto de Venta</MenuItem>
                <MenuItem value="tienda-en-linea">Tienda en Línea</MenuItem>
              </TextField>

              <TextField
                label="Asunto"
                name="subject"
                value={supportForm.subject}
                onChange={handleSupportChange}
                required
                fullWidth
                inputProps={{ maxLength: 255 }}
                disabled={sendingSupport}
              />

              <TextField
                label="Descripción del problema"
                name="description"
                value={supportForm.description}
                onChange={handleSupportChange}
                required
                fullWidth
                multiline
                minRows={4}
                disabled={sendingSupport}
              />
            </Box>
          </DialogContent>

          <DialogActions sx={{ px: 3, pb: 2 }}>
            <Button
              type="button"
              onClick={handleCloseSupport}
              disabled={sendingSupport}
            >
              Cerrar
            </Button>

            <Button
              type="submit"
              variant="contained"
              disabled={sendingSupport}
              startIcon={sendingSupport ? <CircularProgress size={18} /> : null}
            >
              {sendingSupport ? "Enviando..." : "Enviar ticket"}
            </Button>
          </DialogActions>
        </Box>
      </Dialog>
    </Box>
  );
}
